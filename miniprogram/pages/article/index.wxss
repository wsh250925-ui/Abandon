.article-page{min-height:100vh;box-sizing:border-box;padding:42rpx 34rpx;background:#fff;color:#10254b}.eyebrow{font-size:22rpx;color:#315bd6;font-weight:700}.title{font-size:42rpx;line-height:1.35;font-weight:800;margin:17rpx 0}.summary{color:#64748b;font-size:27rpx;line-height:1.6}.cover{width:100%;border-radius:20rpx;margin:28rpx 0}.content{white-space:pre-wrap;font-size:29rpx;line-height:1.85}.notice{margin-top:60rpx;padding:22rpx;border-radius:16rpx;background:#f0f5ff;color:#64748b;font-size:23rpx;line-height:1.6}
.content image{max-width:100%;height:auto;border-radius:14rpx;margin:16rpx 0}
.article-status{padding:80rpx 34rpx;font-size:27rpx;color:#64748b;text-align:center}.article-image-block{margin:22rpx 0;white-space:normal}.article-image{display:block;width:100%;border-radius:16rpx}.image-status{padding:34rpx 20rpx;border-radius:16rpx;background:#eff4ff;color:#315bd6;font-size:24rpx;text-align:center}
