page{background:#f8f9ff}.aed-page{width:100%;box-sizing:border-box;padding:20rpx 24rpx calc(160rpx + env(safe-area-inset-bottom));color:#10254b}.toolbar{display:flex;gap:16rpx;margin-bottom:22rpx}button::after{border:none}button{margin:0;box-sizing:border-box}button:active{opacity:.85}.search{flex:1;min-width:0;display:flex;align-items:center;justify-content:center;gap:12rpx;height:94rpx;padding:0 12rpx;background:linear-gradient(135deg,#2359df,#0037b0);color:#fff;border-radius:22rpx;font-size:30rpx;font-weight:700;box-shadow:0 8rpx 18rpx #1d4ed830}.search[disabled]{color:#e5edff;background:#4672d7}.search-icon{font-size:46rpx;line-height:1}.filter{width:110rpx;height:94rpx;display:flex;flex-direction:column;justify-content:center;align-items:center;line-height:1.3;border-radius:22rpx;background:white;color:#1d4ed8;font-size:30rpx;font-weight:700;box-shadow:0 5rpx 15rpx #18356012}.filter text{font-size:20rpx;font-weight:400}.map-frame{height:660rpx;border-radius:26rpx;overflow:hidden;border:1rpx solid #e0e9f8;box-shadow:0 8rpx 24rpx #18356012;background:#eaf1fc}.map{width:100%;height:100%}.map-placeholder{height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;background:linear-gradient(145deg,#e4edff,#f2f6ff);font-size:25rpx;color:#63758f;line-height:1.8}.location-symbol{width:120rpx;height:120rpx;line-height:120rpx;text-align:center;border-radius:50%;background:white;color:#1d4ed8;font-size:70rpx;box-shadow:0 12rpx 30rpx #1d4ed81c;margin-bottom:26rpx}.placeholder-title{font-size:32rpx;font-weight:700;color:#153568}.map-placeholder text{font-size:22rpx;margin-top:10rpx}.location-row{display:flex;align-items:center;justify-content:space-between;padding:22rpx 2rpx}.location-status{font-size:23rpx;font-weight:700;color:#1d4ed8}.location-row text{font-size:20rpx;color:#8290a6}.recenter{display:flex;align-items:center;height:64rpx;padding:0 18rpx;border-radius:16rpx;background:white;color:#1d4ed8;font-size:22rpx;box-shadow:0 4rpx 12rpx #