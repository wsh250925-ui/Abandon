page{background:#f7f9ff}.list-page{min-height:100vh;box-sizing:border-box;padding:34rpx 24rpx 54rpx;background:#f7f9ff;color:#10254b}.page-heading{padding:8rpx 8rpx 24rpx}.eyebrow{font-size:21rpx;color:#315bd6;font-weight:700;letter-spacing:2rpx}.title{font-size:42rpx;font-weight:800;margin-top:8rpx}.subtitle{font-size:22rpx;color:#71809b;margin-top:8rpx}.search-bar{height:78rpx;display:flex;align-items:center;box-sizing:border-box;padding:0 22rpx;border:1rpx solid #dbe5f7;border-radius:22rpx;background:#fff;box-shadow:0 7rpx 17rpx rgba(28,63,128,.07);margin-bottom:22rpx}.search-icon{font-size:38rpx;color:#315bd6;margin-right:10rpx;line-height:1}.search-bar input{flex:1;font-size:25rpx;color:#10254b}.clear{font-size:38rpx;color:#8b98ac;padding:0 5rpx}.video-list{display:flex;flex-direction:column;gap:16rpx}.video-card{display:flex;gap:18rpx;padding:16rpx;border-radius:22rpx;background:#fff;border:1rpx solid #e2e9f7;box-shadow:0 8rpx 20rpx rgba(28,63,128,.075)}.video-cover-wrap{position:relative;width:218rpx;height:168rpx;flex:none;overflow:hidden;border-radius:16rpx;background:#dce8ff}.video-cover{width:100%;height:100%;display:block}.video-duration{position:absolute;top:9rpx;right:9rpx;padding:4rpx 9rpx;border:1rpx solid rgba(255,255,255,.55);border-radius:6rpx;background:rgba(11,28,48,.68);color:#fff;font-size:18rpx}.video-info{min-width:0;flex:1;display:flex;flex-direction:column}.video-badge{align-self:flex-start;background:#e9f1ff;color:#315bd6;border-radius:6rpx;padding:5rpx 10rpx;font-size:19rpx;font-weight:700}.video-title{font-size:28rpx;font-weight:800;line-height:1.35;margin-top:8rpx;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.video-desc{font-size:21rpx;color:#71809b;line-height:1.35;margin-top:6rpx;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.video-bottom{display:flex;align-items:center;justify-content:space-between;gap:8rpx;margin-top:auto;color:#71809b;font-size:19rpx}.start-button{margin:0;padding:0 15rpx;height:54rpx;line-height:54rpx;border-radius:27rpx;background:#2353d4;color:#fff;font-size:21rpx;font-weight:700;box-shadow:0 5rpx 11rpx rgba(35,83,212,.22)}.empty{text-align:center;padding:100rpx 0;color:#8b98ac;font-size:24rpx}
