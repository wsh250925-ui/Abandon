<view class="list-page">
  <view class="page-heading"><view class="eyebrow">学习内容</view><view class="title">视频课</view><view class="subtitle">选择一门课程，按自己的节奏开始学习</view></view>
  <view class="search-bar"><text class="search-icon">⌕</text><input value="{{keyword}}" confirm-type="search" placeholder="搜索视频课标题" bindinput="onSearch"/><text wx:if="{{keyword}}" class="clear" bindtap="onSearch">×</text></view>
  <view wx:if="{{loading}}" class="empty">正在加载课程…</view>
  <view wx:elif="{{!courses.length}}" class="empty">没有找到相关视频课</view>
  <view wx:else class="video-list"><view wx:for="{{courses}}" wx:key="id" class="video-card"><view class="video-cover-wrap"><image class="video-cover" src="{{item.cover}}" mode="aspectFill"/><text class="video-duration">{{item.durationText}}</text></view><view class="video-info"><view class="video-badge">{{item.badge}}</view><view class="video-title">{{item.title}}</view><view class="video-desc">{{item.description}}</view><view class="video-bottom"><text>{{item.lessonCount}}节 · {{item.grouped?'课程组':'独立课程'}}</text><button class="start-button" data-id="{{item.id}}" bindtap="startLesson">开始学习</button></view></view></view></view>
</view>
