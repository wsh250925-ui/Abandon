page{background:#f8f9ff}.home-page{min-height:100vh;box-sizing:border-box;padding:0 24rpx calc(150rpx + env(safe-area-inset-bottom));color:#0b1c30;background:#f8f9ff}.top-space{height:20rpx}.surface-card{background:#fff;border:1rpx solid #e2e8f0;border-radius:24rpx;box-shadow:0 6rpx 18rpx rgba(24,53,96,.075)}.resume-card{padding:22rpx;margin-bottom:22rpx}.card-kicker{height:28rpx;display:flex;align-items:center;gap:10rpx;color:#0037b0;font-size:22rpx;font-weight:700;margin-bottom:15rpx}.tiny-play{height:30rpx;width:30rpx;border-radius:50%;background:#eff4ff;color:#0037b0;display:flex;align-items:center;justify-content:center;font-size:14rpx}.resume-body{display:flex;gap:22rpx;align-items:center}.resume-cover-wrap{width:184rpx;height:154rpx;flex:none;position:relative;overflow:hidden;border-radius:14rpx;background:#dce9ff;box-shadow:0 5rpx 12rpx rgba(32,76,145,.16)}.resume-cover,.course-cover{width:100%;height:100%;display:block}.cover-caption{position:absolute;bottom:6rpx;left:8rpx;background:rgba(11,28,48,.68);color:#fff;padding:3rpx 8rpx;border-radius:4rpx;font-size:18rpx}.resume-detail{flex:1;min-width:0;display:flex;flex-direction:column;justify-content:space-between;height:154rpx}.resume-title{font-size:29rpx;font-weight:700;line-height:1.25;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.resume-sub{color:#475569;font-size:23rpx;line-height:1.35;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.resume-bottom{display:flex;align-items:center;gap:16rpx}.progress-track{height:12rpx;border-radius:12rpx;overflow:hidden;flex:1;background:#d3e3ff;box-shadow:inset 0 2rpx 4rpx rgba(20,57,125,.09)}.progress-fill{height:100%;border-radius:12rpx;background:#0037b0;box-shadow:0 2rpx 5rpx rgba(0,55,176,.28)}.continue-button{height:48rpx;line-height:48rpx;background:#0037b0;color:#fff;padding:0 17rpx;border-radius:30rpx;font-size:21rpx;font-weight:700;white-space:nowrap;box-shadow:0 5rpx 10rpx rgba(0,55,176,.27)}.continue-button:active{transform:scale(.96);