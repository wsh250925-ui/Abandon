<view class="home-page">
  <view class="top-space"></view>
  <view class="course-section"><view class="course-section-head" bindtap="openVideoList"><view><view class="section-title">每日精选课程</view><view class="section-sub">左右滑动浏览更多课程</view></view><text class="section-chevron">›</text></view><swiper wx:if="{{courses.length}}" class="featured-swiper" bindchange="onCourseSwiperChange" autoplay="true" interval="4500" duration="420" circular="true"><swiper-item wx:for="{{courses}}" wx:key="id"><view class="featured-course surface-card {{item.kind}}" data-id="{{item.id}}" bindtap="openCourse"><image src="{{item.cover}}" mode="aspectFill"/><view class="featured-mask"></view><view class="category featured-category {{item.tone}}">{{item.category}}</view><text class="duration">{{item.meta}}</text><view class="featured-name">{{item.title}}</view><view class="featured-score">{{item.score}}</view><view class="featured-play">▶</view></view></swiper-item></swiper><view wx:if="{{courses.length}}" class="featured-dots"><view wx:for="{{courses}}" wx:key="id" class="featured-dot {{index===currentCourseIndex?'active':''}}"></view></view></view>

  <view wx:if="{{course}}" class="resume-card surface-card"><view class="card-kicker"><view class="tiny-play">▶</view><text>继续学习 · 进度 {{course.percent}}%</text></view><view class="resume-body"><view class="resume-cover-wrap"><image class="resume-cover" src="{{course.cover}}" mode="aspectFill"/><text class="cover-caption">实操演练</text></view><view class="resume-detail"><view class="resume-title">{{course.title}}</view><view class="resume-sub">{{course.lesson}}</view><view class="time-line"><text>已观看 {{course.currentText}}</text><text>总时长 {{course.totalText}}</text></view><view class="resume-bottom"><view class="progress-track"><view class="progress-fill" style="width: {{course.percent}}%;"></view></view><view class="continue-button" bindtap="openCourse">继续 <text>→</text></view></view></view></view></view>

  <view class="quiz-card surface-card"><view class="quiz-heading"><view class="heading-left"><view class="medal">★</view><text>急救速答</text></view><view class="challenge-tag">每日知识挑战</view></view><view class="quiz-inner"><view class="question-heading"><text class="single-tag">单选</text><text class="question-text">{{question.stem}}</text></view><view class="answer-list"><view wx:for="{{options}}" wx:key="letter" class="answer-option {{item.state}}" data-index="{{item.index}}" bindtap="chooseAnswer"><text class="answer-letter">{{item.letter}}</text><text class="answer-label">{{item.text}}</text><text wx:if="{{item.state==='is-correct'}}" class="answer-state">✓</text><text wx:if="{{item.state==='is-wrong'}}" class="answer-state wrong-state">×</text></view></view><view wx:if="{{hasAnswered}}" class="answer-feedback">{{quickResult.correct?'回答正确':'回答错误'}}<view>{{quickResult.explanation}}</view></view><view class="quiz-footer"><text>{{hasAnswered?'今日挑战已完成':'点击选项直接作答'}}</text><text bindtap="openQuestions">更多习题 →</text></view></view></view>

  <view wx:if="{{recommendedArticle}}" class="article-recommend surface-card" data-id="{{recommendedArticle._id}}" bindtap="openArticle"><view class="recommend-head"><view><view class="section-title">每日推荐图文课</view><view class="section-sub">用几分钟掌握一个急救知识点</view></view><text class="section-chevron">›</text></view><view class="recommend-body"><view class="recommend-cover-wrap" style="width:190rpx;height:146rpx;flex:0 0 190rpx;overflow:hidden;border-radius:14rpx;background:#dbe8ff"><image class="recommend-cover" src="{{recommendedArticle.cover}}" mode="aspectFill"/></view><view class="recommend-info"><view class="recommend-badge">图文课程</view><view class="recommend-title">{{recommendedArticle.title}}</view><view class="recommend-summary">{{recommendedArticle.summary}}</view><view class="recommend-link">立即阅读　›</view></view></view></view>

  <view class="bottom-nav"><view class="nav-item active"><text class="nav-symbol">◉</text><text>首页</text></view><view class="nav-item" bindtap="nav" data-url="/pages/aed/index"><text class="nav-symbol">⌖</text><text>AED导航</text></view><view class="emergency-nav {{emergencyPressing?'pressing':''}}" bindtouchstart="startEmergency" bindtouchend="cancelEmergency" bindtouchcancel="cancelEmergency"><view class="emergency-disc">☎</view><text>{{emergencyPressing?'松开取消':'长按120'}}</text></view><view class="nav-item" bindtap="nav" data-url="/pages/study/index"><text class="nav-symbol">◇</text><text>学习</text></view><view class="nav-item" bindtap="nav" data-url="/pages/profile/index"><text class="nav-symbol">♙</text><text>我的</text></view></view>
</view>
