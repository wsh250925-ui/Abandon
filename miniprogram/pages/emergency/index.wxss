.page{min-height:100vh;background:#fff8f7;color:#17231b;padding-bottom:145rpx}.intro{text-align:center;padding:90rpx 50rpx 0}.eyebrow{color:#ef6056;font-size:25rpx}.title{font-size:42rpx;font-weight:700;margin-top:18rpx}.sub{font-size:25rpx;color:#89928d;margin-top:20rpx;line-height:1.6}.wrap{display:flex;justify-content:center;padding:95rpx 0 100rpx}.button{width:400rpx;height:400rpx;border-radius:50%;background:#ef6056;color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;box-shadow:0 18rpx 0 #db4e46,0 25rpx 50rpx rgba(239,96,86,.25)}.button.pressing{transform:scale(.96)}.button>text{font-size:100rpx;font-weight:700}.button>view{font-size:25rpx;margin-top:16rpx}.notice{margin:0 38rpx;padding:26rpx 30rpx;border-radius:20rpx;background:#fff0ee;color:#8c5e5b;font-size:24rpx;line-height:1.6}.notice b{display:block;color:#694845;margin-bottom:8rpx}.nav{position:fixed;z-index:5;left:0;right:0;bottom:0;height:116rpx;background:#fff;display:flex;justify-content:space-around;align-items:center;border-top:1rpx solid #f0e8e7}.nav view{display:flex;flex-direction:column;align-items:center;font-size:21rpx;color:#849088;gap:4rpx}.call{width:94rpx;height:94rpx;border-radius:50%;background:#ef6056;color:#fff!important;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:27rpx!important;margin-top:-32rpx}
