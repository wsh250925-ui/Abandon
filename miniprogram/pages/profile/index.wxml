<view class="profile-page">
  <view class="profile-card surface-card"><view class="avatar-wrap"><button class="avatar-button" open-type="chooseAvatar" bindchooseavatar="chooseAvatar"><image class="avatar" src="{{avatarUrl}}" mode="aspectFill"/></button><view class="verified">✓</view></view><view class="user"><view class="name">{{nickname}}</view><input class="edit" type="nickname" value="{{nickname}}" placeholder="修改昵称" bindblur="editNickname"/></view></view>
  <view class="stats-card surface-card"><view class="stats"><view class="stat primary"><text class="num">{{days}}</text><text class="unit">天</text><text class="label">学习打卡</text></view><view class="stat"><text class="num">{{courses}}</text><text class="unit">节</text><text class="label">学习课程</text></view><view class="stat"><text class="num">{{questions}}</text><text class="unit">组</text><text class="label">完成题组</text></view></view><view class="week-title"><text>本周学习足迹</text><text class="rate">按实际观看计时</text></view><view class="week"><view wx:for="{{week}}" wx:key="day"><text class="day">{{item.day}}</text><view class="dot {{item.done?'done':''}}">{{item.done?'✓':''}}</view></view></view><view class="checkin"><view class="checkin-info"><text class="star">★</text><view><text>保持学习习惯</text><text class="sub">已打卡：{{days}}天</text></view></view><view class="share" bindtap="sharePoster">⌯ {{shareText}}</view></view></view>
  <view class="recent-card surface-card" bindtap="openStudy"><view class="recent-head"><view><text class="book">▣</text><text class="recent-title">最近在学</text></view></view><view class="recent-inner"><view class="course-title">{{recent.title}}</view><view class="subtext">{{recent.lesson}}</view><view class="recent-time"><text>已观看 {{recent.currentText}}</text><text>总时长 {{recent.totalText}}</text><text>{{recent.progress}}%</text></view><view class="progress"><view style="width:{{recent.progress}}%;"></view></view><view class="recent-bottom"><text>急救知识学习</text><view class="continue">继续上课 →</view></view></view></view>
  <view class="settings surface-card"><view class="settings-title">安全与设置</view><view class="setting"><view class="setting-icon">◐</view><view class="setting-info"><text>匿名参与排行榜</text><text>开启后榜单不展示微信昵称</text></view><switch checked="{{anonymousInRanking}}" bindchange="toggleAnonymous" color="#2353d4"/></view><view class="divider"></view><view wx:if="{{isAdmin}}" class="setting" bindtap="openAdmin"><view class="setting-icon">◎</view><view class="setting-info"><text>开发者管理后台</text><text>上传课程、编辑题库与用户数据</text></view><text class="arrow">›</text></view></view>
  <view class="note">本平台仅作急救知识科普 · 遇到紧急情况请优先联系专业医疗人员</view>
</view>
