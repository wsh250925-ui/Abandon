page{background:#f8f9ff}.profile-page{min-height:100vh;box-sizing:border-box;padding:20rpx 24rpx calc(150rpx + env(safe-area-inset-bottom));background:#f8f9ff;color:#0b1c30}.surface-card{background:#fff;border:1rpx solid #e2e8f0;border-radius:24rpx;box-shadow:0 6rpx 18rpx rgba(24,53,96,.075)}.profile-card{height:160rpx;box-sizing:border-box;padding:24rpx 26rpx;display:flex;align-items:center;margin-bottom:20rpx}.avatar-wrap{position:relative;width:112rpx;height:112rpx}.avatar{height:112rpx;width:112rpx;border-radius:50%;display:block;box-shadow:0 5rpx 12rpx rgba(24,53,96,.15)}.verified{position:absolute;right:-3rpx;bottom:0;width:37rpx;height:37rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#1d4ed8;border:4rpx solid #fff;color:#fff;font-size:21rpx;box-shadow:0 3rpx 7rpx rgba(29,78,216,.28)}.user{margin-left:22rpx}.name{font-size:34rpx;font-weight:700}.edit{font-size:22rpx;color:#475569;margin-top:8rpx}.edit text{color:#1d4ed8;font-size:29rpx}.stats-card{padding:22rpx;margin-bottom:20rpx}.stats{display:flex;gap:10rpx}.stat{height:100rpx;flex:1;border-radius:14rpx;background:#eff4ff;display:flex;align-items:center;justify-content:center;flex-wrap:wrap;align-content:center}.num{font-size:41rpx;font-weight:800}.primary .num,.primary .unit{color:#1d4ed8}.unit{font-size:20rpx;font-weight:700;margin-left:4rpx}.label{width:100%;text-align:center;color:#475569;font-size:20rpx;margin-top:5rpx}.week-title{display:flex;justify-content:space-between;margin:23rpx 2rpx 13rpx;color:#475569;font-size:21rpx}.rate{color:#1d4ed8;font-weight:700}.week{height:88rpx;background:#f8faff;border-radius:16rpx;display:flex;justify-content:space-around;align-items:center}.week>view{display:flex;flex-direction:column;align-items:center;gap:8rpx;color:#475569;font-size:20rpx}.day.today{color:#1d4ed8;font-weight:700}.dot{width:46rpx;height:46rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#dce9ff;color:#fff;font-size:25rpx}.dot.done{background:#1d4ed8;box-shadow:0 3rpx 8rpx rgba(29,78,216,.3)}.checkin{height:90rpx;padding:0 14rpx;margin-top:18rpx;border-radius:14rpx;background:#eff4ff;display:flex;justify-content:space-between;align-items:center}.checkin-info{display:flex;align-items:center;gap:10rpx;color:#1d4ed8;font-size:22rpx;font-weight:700}.star{width:31rpx;height:31rpx;border-radius:50%;background:#1d4ed8;color:#fff;text-align:center;line-height:31rpx}.sub{display:block;color:#475569;font-size:20rpx;font-weight:400;margin-top:3rpx}.share{background:#1d4ed8;color:#fff;border-radius:28rpx;padding:11rpx 17rpx;font-size:20rpx;font-weight:600;box-shadow:0 5rpx 11rpx rgba(29,78,216,.27)}.recent-card{padding:22rpx;margin-bottom:20rpx}.recent-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:16rpx}.book{font-size:30rpx;color:#1d4ed8;margin-right:9rpx}.recent-title{font-size:28rpx;font-weight:700}.time{font-size:20rpx;color:#475569}.recent-inner{padding:20rpx;background:#eff4ff;border-radius:14rpx}.course-title{font-size:27rpx;font-weight:700;line-height:1.35;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.subtext{font-size:21rpx;color:#475569;margin-top:9rpx}.progress{height:12rpx;border-radius:10rpx;background:#d3e3ff;overflow:hidden;margin-top:17rpx}.progress view{height:100%;border-radius:10rpx;background:#1d4ed8;box-shadow:0 2rpx 5rpx rgba(29,78,216,.3)}.recent-bottom{display:flex;align-items:center;justify-content:space-between;margin-top:17rpx;color:#1d4ed8;font-size:19rpx;gap:10rpx}.continue{background:#1d4ed8;color:#fff;border-radius:28rpx;padding:11rpx 17rpx;font-size:20rpx;font-weight:600;box-shadow:0 5rpx 11rpx rgba(29,78,216,.27)}.settings{overflow:hidden;margin-bottom:18rpx}.settings-title{font-size:29rpx;font-weight:700;padding:25rpx 24rpx 15rpx}.setting{min-height:94rpx;padding:16rpx 24rpx;box-sizing:border-box;display:flex;align-items:center;gap:14rpx}.setting-icon{height:52rpx;width:52rpx;display:flex;align-items:center;justify-content:center;background:#eff4ff;border-radius:12rpx;color:#1d4ed8;font-size:27rpx;box-shadow:0 2rpx 5rpx rgba(29,78,216,.08)}.setting-info{flex:1;min-width:0;display:flex;flex-direction:column}.setting-info text:first-child{font-size:24rpx;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.setting-info text:last-child{font-size:20rpx;color:#64748b;margin-top:5rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.extra{color:#1d4ed8;font-size:19rpx;white-space:nowrap}.arrow{font-size:32rpx;color:#475569}.divider{height:1rpx;background:#e2e8f0;margin:0 24rpx}.note{text-align:center;color:#7b8796;font-size:18rpx;line-height:1.5;padding:0 20rpx 8rpx}.bottom-nav{position:fixed;z-index:20;left:0;right:0;bottom:0;height:112rpx;padding-bottom:env(safe-area-inset-bottom);background:rgba(255,255,255,.98);display:flex;justify-content:space-around;align-items:center;border-top:1rpx solid #e2e8f0;box-shadow:0 -8rpx 24rpx rgba(11,28,48,.09)}.nav-item{display:flex;flex-direction:column;align-items:center;justify-content:center;min-width:80rpx;color:#64748b;font-size:20rpx;font-weight:600;gap:2rpx}.nav-item.active{color:#1d4ed8}.symbol{font-size:35rpx;line-height:39rpx;text-shadow:0 2rpx 4rpx rgba(29,78,216,.12)}.emergency{width:106rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;margin-top:-34rpx;color:#bb0112;font-size:19rpx;font-weight:700}.emergency view{height:92rpx;width:92rpx;border-radius:50%;background:#bb0112;color:#fff;display:flex;align-items:center;justify-content:center;box-shadow:0 9rpx 22rpx rgba(187,1,18,.34),inset 0 2rpx 2rpx rgba(255,255,255,.25);font-size:40rpx}.emergency text{margin-top:5rpx}
.recent-time{display:flex;justify-content:space-between;align-items:center;color:#315bd6;font-size:19rpx;margin-top:15rpx;font-weight:600}
