page{background:#f8f9ff}.study-page{min-height:100vh;box-sizing:border-box;padding:25rpx 24rpx calc(150rpx + env(safe-area-inset-bottom));color:#0b1c30;background:#f8f9ff}.section-title{display:flex;align-items:center;justify-content:space-between;font-size:28rpx;font-weight:700;margin:12rpx 2rpx 15rpx}.section-title>view{display:flex;align-items:center;gap:8rpx}.section-title i{display:inline-block;width:7rpx;height:31rpx;border-radius:8rpx;background:#1d4ed8}.section-title>text{font-size:20rpx;color:#475569;font-weight:500}.hero-scroll{width:100%;white-space:nowrap;display:flex}.hero-card,.small-video{display:inline-block;vertical-align:top;position:relative;overflow:hidden;border-radius:18rpx;background:#fff;box-shadow:0 6rpx 16rpx rgba(24,53,96,.12)}.hero-card{width:100%;height:340rpx;margin-right:16rpx}.hero-card image{width:100%;height:100%;display:block}.hero-mask{position:absolute;inset:0;background:linear-gradient(180deg,rgba(8,30,52,.05) 28%,rgba(5,21,37,.84) 100%)}.hero-tag{position:absolute;left:17rpx;top:16rpx;padding:6rpx 13rpx;background:#ee4e45;color:#fff;border-radius:5rpx;font-size:18rpx;font-weight:700}.hero-name{position:absolute;left:20rpx;bottom:53rpx;color:#fff;font-size:32rpx;font-weight:700}.hero-meta{position:absolute;left:20rpx;bottom:24rpx;color:#dbe7f5;font-size:19rpx}.hero-time{position:absolute;right:14rpx;bottom:13rpx;padding:4rpx 9rpx;background:rgba(10,23,38,.68);color:#fff;font-size:18rpx;border-radius:5rpx}.hero-play{position:absolute;left:50%;top:50%;width:76rpx;height:76rpx;margin:-38rpx 0 0 -38rpx;border-radius:50%;background:#1d4ed8;color:#fff;display:flex;align-items:center;justify-content:center;font-size:31rpx;padding-left:5rpx;box-shadow:0 7rpx 15rpx rgba(29,78,216,.45)}.small-video{width:205rpx;height:230rpx;margin-right:12rpx;white-space:normal}.small-video image{width:100%;height:130rpx;display:block}.small-play{position:absolute;top:42rpx;left:82rpx;width:42rpx;height:42rpx;border-radius:50%;background:#fff;color:#1d4e