<view class="study-page">
  <view class="section-title"><view><i></i>精选视频课</view><text>持续更新</text></view>
  <swiper wx:if="{{videoCourses.length}}" class="hero-swiper" bindchange="onSwiperChange" autoplay="true" interval="4500" duration="360" circular="true">
    <swiper-item wx:for="{{videoCourses}}" wx:key="_id"><view class="hero-card {{item.cardKind}}" data-id="{{item._id}}" bindtap="openVideo"><image src="{{item.cover || '../../images/home/cpr.jpg'}}" mode="aspectFill"/><view class="hero-mask"></view><view class="hero-tag {{item.cardKind}}">{{item.badge || '精选课程'}}</view><view class="hero-name">{{item.title || '急救知识学习'}}</view><view class="hero-meta">{{item.meta || '由管理员上传课程内容'}}</view><view class="hero-time">{{item.time || ''}}</view><view class="hero-play">▶</view></view></swiper-item>
  </swiper><view wx:if="{{videoCourses.length}}" class="swiper-dots"><view wx:for="{{videoCourses}}" wx:key="_id" class="swiper-dot {{index===currentVideoIndex?'active':''}}"></view></view>
  <view class="feature-grid"><view class="feature-item" bindtap="openVideoList"><view class="feature-icon blue">▣</view><text>视频课</text><small>观看学习</small></view><view class="feature-item" bindtap="openArticleList"><view class="feature-icon blue">▤</view><text>图文课</text><small>速读必备</small></view><view class="feature-item" bindtap="rank"><view class="feature-icon amber">♛</view><text>排行榜</text><small>学习激励</small></view><view class="feature-item" bindtap="openQuizList"><view class="feature-icon slate">？</view><text>习题测试</text><small>题库训练</small></view></view>
  <view class="section-title daily"><view><i></i>每日高频必练</view><text>可反复作答</text></view>
  <view class="question-list"><view class="question-card" wx:for="{{questions}}" wx:key="id" bindtap="quiz" data-id="{{item.id}}"><view class="question-top"><text class="question-tag">{{item.tag}}</text></view><view class="question-name">{{item.title}}</view><view class="answer-button">去答题 ›</view></view></view>
  <view class="section-title article-head"><view><i></i>热门图文课程</view><text>持续更新</text></view><view class="article-list"><view class="article-card" wx:for="{{articles}}" wx:key="_id" data-id="{{item._id}}" bindtap="openArticle"><image src="{{item.cover}}" mode="aspectFill"/><view class="article-info"><view class="article-name">{{item.title}}</view><view class="article-meta">▤ {{item.meta}}</view></view><text class="article-arrow">›</text></view></view>
</view>
