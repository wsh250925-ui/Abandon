page{background:#f7f9ff}.quiz-page{min-height:100vh;background:#f7f9ff;padding:24rpx 24rpx 60rpx;box-sizing:border-box;color:#10254b}.hero{padding:20rpx 8rpx 28rpx}.eyebrow{font-size:21rpx;color:#315bd6;font-weight:700;letter-spacing:2rpx}.hero-title{font-size:40rpx;font-weight:800;line-height:1.25;margin-top:12rpx}.hero-sub{font-size:22rpx;color:#71809b;margin-top:10rpx}.search-bar{height:78rpx;display:flex;align-items:center;box-sizing:border-box;padding:0 22rpx;margin-bottom:22rpx;border:1rpx solid #dbe5f7;border-radius:22rpx;background:#fff;box-shadow:0 7rpx 17rpx rgba(28,63,128,.07)}.search-icon{font-size:38rpx;color:#315bd6;margin-right:10rpx}.search-bar input{flex:1;font-size:25rpx}.clear{font-size:38rpx;color:#8b98ac;padding:0 5rpx}.panel{background:#fff;border:1rpx solid #e1e9f8;border-radius:26rpx;padding:24rpx;box-shadow:0 10rpx 26rpx rgba(28,63,128,.08);margin-bottom:24rpx}.panel-title{font-size:30rpx;font-weight:800;margin-bottom:18rpx}.set-card{display:flex;align-items:center;gap:16rpx;padding:20rpx 4rpx;border-bottom:1rpx solid #edf1f9}.set-card:last-child{border-bottom:0}.set-icon{height:58rpx;width:58rpx;border-radius:18rpx;background:#eaf1ff;color:#2353d4;display:flex;align-items:center;justify-content:center;font-size:31rpx;font-weight:800}.set-main{flex:1;min-width:0}.set-title{font-size:27rpx;font-weight:700}.set-desc{font-size:21rpx;color:#71809b;margin-top:6rpx}.arrow{font-size:38rpx;color:#315bd6}.progress-head{display:flex;justify-content:space-between;gap:12rpx;color:#315bd6;font-size:23rpx;font-weight:700}.bar{height:12rpx;background:#dbe7ff;border-radius:10rpx;margin:16rpx 0 24rpx;overflow:hidden}.bar view{height:100%;border-radius:10rpx;background:#2353d4;box-shadow:0 3rpx 8rpx rgba(35,83,212,.3)}.question-card{background:#eff4ff;border-radius:18rpx;padding:24rpx;margin-bottom:18rpx}.question-tag{display:inline-block;color:#2353d4;background:#dce9ff;border-radius:8rpx;font-size:20rpx;padding:6rpx 10rpx;font-weight:700}.question{font-size:31rpx;font-weight:800;line-height:1.45;margin-top:15rpx}.option{display:flex;align-items:center;min-height:84rpx;padding:16rpx 18rpx;margin:14rpx 0;background:#fff;border:1rpx solid #e1e9f8;border-radius:17rpx;box-shadow:0 5rpx 12rpx rgba(28,63,128,.06);font-size:26rpx}.option.selected{border-color:#4e78df;background:#eef4ff;box-shadow:0 5rpx 13rpx rgba(35,83,212,.14)}.radio{width:42rpx;height:42rpx;flex:none;border-radius:50%;border:2rpx solid #b8c8e8;display:flex;align-items:center;justify-content:center;margin-right:16rpx;color:#fff;background:#fff;font-weight:800}.selected .radio{background:#2353d4;border-color:#2353d4}.primary-btn{margin-top:26rpx;background:#2353d4;color:#fff;border-radius:30rpx;font-size:27rpx;font-weight:700;box-shadow:0 7rpx 14rpx rgba(35,83,212,.25)}.primary-btn text{font-size:34rpx;margin-left:8rpx}.ghost-btn{margin-top:14rpx;background:#f3f6fc;color:#315bd6;border-radius:30rpx;font-size:26rpx}.result-panel{text-align:center}.result-badge{display:inline-flex;background:#e5efff;color:#2353d4;border-radius:30rpx;padding:8rpx 22rpx;font-size:21rpx;font-weight:700}.result-score{font-size:82rpx;line-height:1.1;color:#2353d4;font-weight:800;margin-top:14rpx}.result-score text{font-size:28rpx;margin-left:5rpx}.result-caption{font-size:22rpx;color:#71809b;margin-bottom:18rpx}.feedback{text-align:left;border-radius:16rpx;padding:18rpx;margin-top:14rpx}.feedback-head{display:flex;justify-content:space-between;font-size:23rpx;font-weight:800}.feedback-text{font-size:22rpx;line-height:1.55;margin-top:8rpx}.right{background:#eaf5ff;color:#2353d4}.wrong{background:#fff1ef;color:#b94c46}
