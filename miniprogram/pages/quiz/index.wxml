<view class="quiz-page"><view class="hero"><view class="eyebrow">每日练习 · 急救知识</view><view class="hero-title">把关键时刻的判断练成习惯</view><view class="hero-sub">每次完成练习都会记录学习打卡</view></view><view class="search-bar"><text class="search-icon">⌕</text><input value="{{keyword}}" confirm-type="search" placeholder="搜索习题组标题" bindinput="onSearch"/><text wx:if="{{keyword}}" class="clear">×</text></view><view wx:if="{{!setId}}" class="panel"><view class="panel-title">选择一套习题</view><view wx:for="{{sets}}" wx:key="_id" class="set-card" data-id="{{item._id}}" bindtap="selectSet"><view class="set-icon">？</view><view class="set-main"><view class="set-title">{{item.title}}</view><view class="set-desc">{{item.description}}</view></view><text class="arrow">›</text></view></view><view wx:elif="{{submitted}}" class="panel result-panel"><view class="result-badge">完成</view><view class="result-score">{{result.score}}<text>分</text></view><view class="result-caption">答对 {{result.correct}} / {{result.total}} 题 · 每题答对计10分</view><view wx:for="{{result.detail}}" wx:key="questionId" class="feedback {{item.correct?'right':'wrong'}}"><view class="feedback-head"><text>第 {{index+1}} 题</text><text>{{item.correct?'回答正确':'需要复习'}}</text></view><view class="feedback-text">{{item.explanation}}</view></view><button class="primary-btn" bindtap="retry">重新作答</button><button class="ghost-btn" bindtap="backSets">返回题库</button></view><view wx:else class="panel"><view class="progress-head"><text>{{title}}</text><text>第 {{index+1}} / {{questions.length}} 题</text></view><view class="bar"><view style="width:{{(index+1)*100/questions.length}}%;"></view></view><view class="question-card"><view class="question-tag">单选题</view><view class="question">{{questions[index].stem}}</view></view><view class="option {{selected===optionIndex?'selected':''}}" wx:for="{{questions[index].options}}" wx:for-index="optionIndex" wx:key="*this" data-i="{{optionIndex}}" bindtap="choose"><view class="radio">{{selected===optionIndex?'✓':''}}</view><text>{{item}}</text></view><button class="primary-btn" bindtap="next">{{index+1===questions.length?'提交答案':'下一题'}} <text>→</text></button></view></view>
