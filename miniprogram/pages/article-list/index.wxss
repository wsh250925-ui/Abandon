page{background:#f7f9ff}.list-page{min-height:100vh;box-sizing:border-box;padding:34rpx 24rpx 54rpx;background:#f7f9ff;color:#10254b}.page-heading{padding:8rpx 8rpx 24rpx}.eyebrow{font-size:21rpx;color:#315bd6;font-weight:700;letter-spacing:2rpx}.title{font-size:42rpx;font-weight:800;margin-top:8rpx}.subtitle{font-size:22rpx;color:#71809b;margin-top:8rpx}.search-bar{height:78rpx;display:flex;align-items:center;box-sizing:border-box;padding:0 22rpx;border:1rpx solid #dbe5f7;border-radius:22rpx;background:#fff;box-shadow:0 7rpx 17rpx rgba(28,63,128,.07);margin-bottom:22rpx}.search-icon{font-size:38rpx;color:#315bd6;margin-right:10rpx;line-height:1}.search-bar input{flex:1;font-size:25rpx;color:#10254b}.clear{font-size:38rpx;color:#8b98ac;padding:0 5rpx}.article-list{display:flex;flex-direction:column;gap:16rpx}.article-card{display:flex;align-items:center;gap:18rpx;min-height:168rpx;padding:16rpx;border-radius:22rpx;background:#fff;border:1rpx solid #e2e9f7;box-shadow:0 8rpx 20rpx rgba(28,63,128,.075)}.article-card image{width:178rpx;height:140rpx;flex:none;border-radius:15rpx;display:block;background:#e1ebff}.article-info{min-width:0;flex:1}.article-badge{display:inline-block;padding:5rpx 10rpx;border-radius:6rpx;background:#e9f1ff;color:#315bd6;font-size:19rpx;font-weight:700}.article-title{font-size:28rpx;font-weight:800;line-height:1.4;margin-top:8rpx;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.article-summary{font-size:22rpx;line-height:1.4;color:#71809b;margin-top:7rpx;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.article-arrow{flex:none;color:#315bd6;font-size:42rpx;margin-right:5rpx}.empty{text-align:center;padding:100rpx 0;color:#8b98ac;font-size:24rpx}
