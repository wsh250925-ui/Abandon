<view class="admin-page">
  <view class="header"><view class="eyebrow">DEVELOPER CONSOLE</view><view class="title">内容与数据管理</view><view class="sub">仅限开发者 · 所有写入都由云函数校验身份</view></view>
  <view wx:if="{{!ready}}" class="card"><view class="warn">{{error}}</view><view class="openid">当前 OpenID：{{openid || '读取中'}}</view></view>
  <block wx:else>
    <view class="card"><view class="row"><view><view class="card-title">数据库初始化</view><view class="sub">首次运行时建集合并写入两套各 5 题示例</view></view><button size="mini" type="primary" bindtap="bootstrap">初始化</button></view></view>
    <view class="card"><view class="card-title">选择数据</view><picker range="{{types}}" range-key="label" value="{{typeIndex}}" bindchange="changeType"><view class="picker">{{types[typeIndex].label}} <text>切换 ›</text></view></picker><button wx:if="{{!types[typeIndex].readOnly}}" class="new" bindtap="newRecord">＋ 新建{{types[typeIndex].label}}</button></view>
    <view class="card"><view class="card-title">记录列表 <text class="muted">{{rows.length}} 条（最多展示 100 条）</text></view><view wx:for="{{rows}}" wx:key="_id" class="record" data-index="{{index}}" bindtap="editRecord"><view><text class="record-title">{{item.display}}</text><text class="record-id">{{item._id}}</text></view><text class="chevron">编辑 ›</text></view><view wx:if="{{!rows.length}}" class="empty">暂无记录，或尚未初始化</view></view>
    <view wx:if="{{editor}}" class="card editor">
      <view class="card-title">编辑 {{currentId || '新记录'}}</view>
      <view wx:if="{{typeIndex===0 || typeIndex===1 || typeIndex===2 || typeIndex===3}}"><view class="field-label">标题</view><input class="field" value="{{form.title}}" data-field="title" bindinput="updateField"/></view>
      <view wx:if="{{typeIndex===4}}"><view class="field-label">题组 ID</view><input class="field" value="{{form.setId}}" data-field="setId" bindinput="updateField"/><view class="field-label">题干</view><textarea class="field multiline" value="{{form.stem}}" data-field="stem" bindinput="updateField"/><view class="field-label">选项</view><input wx:for="{{form.options}}" wx:key="*this" class="field" value="{{item}}" data-index="{{index}}" bindinput="updateOption"/><view class="field-label">正确答案（0 = 第一项）</view><picker range="{{form.options}}" value="{{form.answer}}" bindchange="updateAnswer"><view class="field">第 {{form.answer+1}} 项：{{form.options[form.answer]}}</view></picker><view class="field-label">答案解析</view><textarea class="field multiline" value="{{form.explanation}}" data-field="explanation" bindinput="updateField"/></view>
      <view wx:if="{{typeIndex===0}}"><view class="field-label">课程组小标</view><input class="field" value="{{form.badge}}" data-field="badge" bindinput="updateField"/></view>
      <view wx:if="{{typeIndex===1}}"><view class="field-label">所属课程组（可选）</view><picker range="{{courseOptions}}" range-key="title" value="{{coursePickerIndex}}" bindchange="updateCourse"><view class="picker field">{{courseOptions[coursePickerIndex].title}} <text>选择 ›</text></view></picker><view class="field-label">课程卡片金色小标题</view><input class="field" value="{{form.subtitle}}" data-field="subtitle" bindinput="updateField"/><view class="field-label">时长（秒）</view><input class="field" type="number" value="{{form.duration}}" data-field="duration" bindinput="updateField"/></view>
      <view wx:if="{{typeIndex===2}}"><view class="field-label">图文正文（最多 5 万字，可插入图片）</view><editor id="articleEditor" class="article-editor" placeholder="输入正文内容，点击下方按钮插入图片" maxlength="50000" show-img-size="true" show-img-toolbar="true" bindready="onEditorReady" bindinput="onArticleInput"></editor><button class="upload" bindtap="uploadArticleImage" loading="{{uploading}}">在光标处插入图片</button></view>
      <view wx:if="{{typeIndex<4}}"><view class="field-label">简介</view><input class="field" value="{{typeIndex===2?form.summary:form.description}}" data-field="{{typeIndex===2?'summary':'description'}}" bindinput="updateField"/></view>
      <view wx:if="{{typeIndex<5}}" class="publish-row"><text>发布给用户</text><switch checked="{{form.published}}" color="#2353d4" bindchange="updatePublished"/></view>
      <button wx:if="{{typeIndex===1 || typeIndex===0}}" class="upload" bindtap="upload" loading="{{uploading}}">上传{{typeIndex===1?'视频':'封面图'}}</button><button wx:if="{{typeIndex===1}}" class="upload" bindtap="uploadCover" loading="{{uploading}}">上传视频封面</button><view wx:if="{{uploadStatus}}" class="upload-success">✓ {{uploadStatus}}</view>
      <view class="hint">{{types[typeIndex].readOnly?'此类数据只供查看，不能在后台修改。':'高级字段（FileID、排序等）可直接编辑 JSON；题目答案从 0 开始计数。'}}</view>
      <textarea wx:if="{{typeIndex!==2}}" value="{{editor}}" bindinput="editText" disabled="{{types[typeIndex].readOnly}}" auto-height="true" maxlength="-1" class="json"/>
      <view wx:if="{{!types[typeIndex].readOnly}}" class="actions"><button type="primary" bindtap="save">保存</button><button wx:if="{{currentId && typeIndex!==5}}" class="delete" bindtap="remove">删除</button></view>
    </view>
  </block>
</view>
