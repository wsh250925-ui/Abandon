/**app.wxss**/
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
} 

button {
  background: initial;
}

button:focus{
  outline: 0;
}

button::after{
  border: none;
}


page {
  background: #f6f6f6;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}

/* 旧页面内嵌导航停用，统一使用微信原生自定义 TabBar。 */
.bottom-nav { display: none !important; }
.avatar-button { padding: 0; margin: 0; width: 112rpx; height: 112rpx; border-radius: 50%; background: transparent; line-height: normal; }
.avatar-button::after { border: 0; }
